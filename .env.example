# Public URL of the deployed site — used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://techvinya.com

# Resend (https://resend.com) — contact form delivery.
# Without RESEND_API_KEY the form still works and logs submissions to the server
# console instead of emailing them, so local development needs no setup.
RESEND_API_KEY=

# Verified sender. Use "TechVinya <hello@techvinya.com>" once your domain is
# verified in Resend; until then Resend's shared onboarding@resend.dev works.
CONTACT_FROM_EMAIL=TechVinya <onboarding@resend.dev>

# Where enquiries are delivered. Comma-separate for multiple recipients.
CONTACT_TO_EMAIL=hello@techvinya.com
