# ---------------------------------------------------------------------------
# PUBLIC configuration
#
# NEXT_PUBLIC_* values are inlined into the JavaScript bundle and rendered into
# the page HTML. They are NOT secret — the site publishes them on purpose.
# They live here so contact details can change without a code change, and so
# real addresses are not committed to a public repository.
# ---------------------------------------------------------------------------

# Public URL of the deployed site — used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://techvinya.com

# Contact details shown in the footer, closing CTA, contact page and schema.org
# markup. The contact form also falls back to NEXT_PUBLIC_CONTACT_EMAIL if
# CONTACT_TO_EMAIL below is unset.
NEXT_PUBLIC_CONTACT_EMAIL=hello@techvinya.com
NEXT_PUBLIC_SALES_EMAIL=sales@techvinya.com

# Phone is displayed as written; the tel: link is derived automatically.
NEXT_PUBLIC_CONTACT_PHONE=+91 00000 00000
NEXT_PUBLIC_CONTACT_ADDRESS=Remote-first · India

# Leave blank to hide the icon in the footer; set a URL and it reappears.
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_GITHUB=

# ---------------------------------------------------------------------------
# SECRETS — server-side only
#
# These are read exclusively in src/app/api/contact/route.ts and never reach the
# browser. Never add the NEXT_PUBLIC_ prefix to anything below: doing so would
# publish your API key in the JavaScript bundle.
# ---------------------------------------------------------------------------

# Resend (https://resend.com) — contact form delivery.
# Without RESEND_API_KEY the form still works and logs submissions to the server
# console instead of emailing them, so local development needs no setup.
RESEND_API_KEY=

# Verified sender. Use the Resend subdomain (send.techvinya.com) so its SPF and
# DKIM records cannot collide with your mailbox provider's records on the apex.
CONTACT_FROM_EMAIL=TechVinya <hello@send.techvinya.com>

# Where enquiries are delivered. Comma-separate for multiple recipients.
CONTACT_TO_EMAIL=hello@techvinya.com
